; Top Design: "sic1_lib:neo_teliko_test:schematic"
; Netlisted using Hierarchy Policy: "Standard"

Options ResourceUsage=yes UseNutmegFormat=no EnableOptim=no TopDesignName="sic1_lib:neo_teliko_test:schematic" DcopOutputNodeVoltages=yes DcopOutputPinCurrents=yes DcopOutputAllSweepPoints=no DcopOutputDcopType=0
; Library Name: sic1_lib
; Cell Name: divider
; View Name: emModel
define divider ( P1  P2  P3  P4  P5  ref=0 ) 
;parameters 
; MomCmpt model has node 0 as implicit reference. Ref node will be ignored and assumed to be grounded!
em_data_name="sic1_lib:divider:emModel"
MomCmpt:em_data  P1 P2 P3 S4 \
    name=em_data_name \
    paramFile="" \
    modelFile="C:/Users/bbana/Desktop/my_projects/sic/sic1_wrk/sic1_lib/divider/em%Model/model.ndx" \
    ModelReuse=1 \
    ModelType="MOMMW" \
    ExtrapolationMode="linear" \
    EnforcePassivity=-1
#uselib "ckt" , "tf"
; Port S4
Short:ShortSP4_1  P4 SP4  Mode=0 SaveCurrent=no
Short:ShortSN4_1  P5 SN4  Mode=0 SaveCurrent=no
tf:TFSP4  SP4 S4 S4_common 0  T=1/2
tf:TFSN4  S4_common S4 SN4 0  T=1/2
R:RS4_common_bias  S4_common 0  R=1e+12
end divider

; Library Name: sic1_lib
; Cell Name: final_coupler
; View Name: emModel
define final_coupler ( P1  P2  P3  P4  ref=0 ) 
;parameters 
; MomCmpt model has node 0 as implicit reference. Ref node will be ignored and assumed to be grounded!
em_data_name="sic1_lib:final_coupler:emModel"
MomCmpt:em_data  P1 P2 P3 P4 \
    name=em_data_name \
    paramFile="" \
    modelFile="C:/Users/bbana/Desktop/my_projects/sic/sic1_wrk/sic1_lib/final_coupler/em%Model/model.ndx" \
    ModelReuse=1 \
    ModelType="MOMMW" \
    ExtrapolationMode="linear" \
    EnforcePassivity=-1
end final_coupler

#uselib "ckt" , "PhaseShift"
PhaseShift:PS1  N__11 N__17 Phase=Phase_SIC PhaseSlope=0. RTConj=0 ZRef=50. Ohm 
#uselib "sml" , "Amplifier2"
Amplifier2:AMP1  in N__3 S21=dbpolar(15,0) S11=polar(0,0) S22=polar(0,180) S12=0 GainCompType=0 ReferToInput=0 TOI=35 GainCompSat=5.0 dB GainComp=1.0 dB ClipDataFile=1 
S_Param:SP1 CalcS=yes CalcY=no CalcZ=no CalcGroupDelay=yes GroupDelayAperture=1e-4 \
FreqConversion=no FreqConversionPort=1 StatusLevel=2 CalcNoise=no SortNoise=0 BandwidthForNoise=1.0 Hz DevOpPtLevel=0 \
SweepVar="freq" SweepPlan="SP1_stim" OutputPlan="SP1_Output" 

SweepPlan: SP1_stim Start=2 GHz Stop=5 GHz Step=0.1 GHz 

OutputPlan:SP1_Output \
      Type="Output" \
      UseEquationNestLevel=yes \
      EquationNestLevel=2 \
      UseSavedEquationNestLevel=yes \
      SavedEquationNestLevel=2

#load "python","LinearCollapse"
Component Module="LinearCollapse" Type="ModelExtractor" NetworkRepresentation=2
Port:TermG4  out 0 Num=2 Z=50 Ohm Noise=yes 
HB:HB1 MaxOrder=4 Freq[1]=3.5 GHz Freq[2]=3.51 GHz Order[1]=5 Order[2]=5 StatusLevel=2 HBSS_WSP=0 OutputPlan="HB1_Output" 

OutputPlan:HB1_Output \
      Type="Output" \
      UseNodeNestLevel=yes \
      NodeNestLevel=2 \
      UseEquationNestLevel=yes \
      EquationNestLevel=2 \
      UseSavedEquationNestLevel=yes \
      SavedEquationNestLevel=2 \
      UseDeviceCurrentNestLevel=no \
      DeviceCurrentNestLevel=0 \
      DeviceCurrentDeviceType="All" \
      DeviceCurrentSymSyntax=yes \
      UseCurrentNestLevel=yes \
      CurrentNestLevel=999 \
      UseDeviceVoltageNestLevel=no \
      DeviceVoltageNestLevel=0 \
      DeviceVoltageDeviceType="All"

Tran:HB1_tran HB_Sol=1 SteadyState=1 StatusLevel=3 \
Freq[1]=3.5 GHz Order[1]=5 

Component:tahb_HB1 Module="ATAHB" Type="ModelExtractor" \ 
 Tran_Analysis="HB1_tran" HB_Analysis="HB1" 

#uselib "ckt" , "Attenuator"
Attenuator:ATTEN4  N__2 N__14 Loss=25 dB VSWR=1 Rref=50 Ohm CheckPassivity=1 ReturnPhase=0 

Phase_SIC=-90 tune{ 0 to 360 by 0.1 } opt{ 0 to 360 }
Atten_SIC=23.7 tune{ 0 to 30 by 0.05 } opt{ 0 to 40 }
divider:X2  out N__14 N__8 N__10 N__12 
#uselib "ckt" , "Attenuator"
Attenuator:ATTEN3  N__8 N__17 Loss=Atten_SIC dB VSWR=1 Rref=50 Ohm CheckPassivity=1 ReturnPhase=0 
final_coupler:X3  N__3 N__15 N__2 N__11 
R:R4  N__12 N__10 R=100 Ohm Noise=yes 
R:R5  N__15 0 R=50 Ohm Noise=yes 
Port:PORT1  in 0 Num=1  Z=50 Ohm  Freq[1]=3.5 GHz Freq[2]=3.51 GHz    P[1]=polar(dbmtow(10),0) P[2]=polar(dbmtow(10),0) Noise=yes Pac=polar(dbmtow(0),0) 
